# Windows에서 복사할 때 생기는 메타파일
*:Zone.Identifier
*Zone.Identifier

# Obsidian 개인 상태 (창 배치·최근 파일 등은 사람마다 다름)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache
.trash/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
build/

# 비밀값 — 절대 커밋하지 않음 (.env.example만 공유)
.env
.env.*
!.env.example
*.pem
*.key

# OS / 에디터
.DS_Store
Thumbs.db
.idea/
.vscode/

# 보안 점검 보고서·도구 출력 — 미조치 취약점 정보가 담기므로 공개 저장소에 커밋하지 않음
# (조치가 끝난 뒤 요약만 docs/security/ 에 기록)
security-reports/
/security-review-report.md
/bandit.json
/semgrep.json
/pip-audit.json
/sbom*.json
/*.cdx.json

# 공고 출처 원본 샘플 — 담당자 연락처 등 개인정보가 섞일 수 있어 커밋하지 않음
worker/samples/

# 모델 가중치 — 공식 배포원에서 revision·digest를 고정해 받는다. 저장소에 넣지 않음 (speech/README.md)
# (backend 안의 DB 모델 파일·폴더와 겹치지 않게 경로를 한정한다)
/models/
/speech/models/
/speech/runtime_vendor/
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
# faster-whisper(CTranslate2) model.bin·Hugging Face pytorch_model.bin
/speech/**/*.bin
# Hugging Face 캐시 폴더 (models--<조직>--<모델>/)
models--*/
# Ollama 모델 저장소 (blobs/sha256-…, manifests/)
**/ollama/blobs/
**/ollama/manifests/
/eval/outputs/

# 프론트엔드 테스트·도구 출력
coverage/
*.tsbuildinfo

# AI 개발 도구 개인 파일 — 팀 공용 지침은 AGENTS.md·CLAUDE.md (개인 규칙은 각자 전역 설정에)
CLAUDE.local.md
**/.claude/settings.local.json
.claude/worktrees/

# 브라우저 자동 검사의 임시 결과 (기준 이미지는 별도 추적)
/frontend/test-results/
/frontend/playwright-report/
