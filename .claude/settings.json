{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(//**/.env.test)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git * push --force*)",
      "Bash(git * push * --force*)",
      "Bash(git * push -f)",
      "Bash(git * push -f *)",
      "Bash(git * push * -f)",
      "Bash(git * push * -f *)",
      "Bash(git * push * +*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * +*)",
      "PowerShell(git * push --force*)",
      "PowerShell(git * push * --force*)",
      "PowerShell(git * push -f)",
      "PowerShell(git * push -f *)",
      "PowerShell(git * push * -f)",
      "PowerShell(git * push * -f *)",
      "PowerShell(git * push * +*)"
    ],
    "ask": [
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --prune*)",
      "Bash(git push --prune*)",
      "Bash(git * push --delete*)",
      "Bash(git * push * --delete*)",
      "Bash(git * push -d *)",
      "Bash(git * push * -d *)",
      "Bash(git * push * :*)",
      "Bash(git * push * --mirror*)",
      "Bash(git * push --mirror*)",
      "Bash(git * push * --prune*)",
      "Bash(git * push --prune*)",
      "PowerShell(git push --delete*)",
      "PowerShell(git push * --delete*)",
      "PowerShell(git push -d *)",
      "PowerShell(git push * -d *)",
      "PowerShell(git push * :*)",
      "PowerShell(git push * --mirror*)",
      "PowerShell(git push --mirror*)",
      "PowerShell(git push * --prune*)",
      "PowerShell(git push --prune*)",
      "PowerShell(git * push --delete*)",
      "PowerShell(git * push * --delete*)",
      "PowerShell(git * push -d *)",
      "PowerShell(git * push * -d *)",
      "PowerShell(git * push * :*)",
      "PowerShell(git * push * --mirror*)",
      "PowerShell(git * push --mirror*)",
      "PowerShell(git * push * --prune*)",
      "PowerShell(git * push --prune*)"
    ]
  }
}
