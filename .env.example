# 복사해서 루트에 .env로 저장한 뒤 값을 채운다. .env는 커밋하지 않는다.
#   macOS·Linux·Git Bash: cp .env.example .env
#   PowerShell:           Copy-Item .env.example .env
# 모든 서비스가 이 파일 하나를 쓴다. Compose의 --env-file .env는 compose 파일의 ${VAR} 치환에만 쓰이므로,
# 컨테이너에 값을 넣으려면 서비스마다 env_file: ../.env 또는 environment:를 적는다 (infra/README.md).
# 주석 처리된 항목은 이름만 잡아 둔 것이다. 해당 이슈에서 실제로 쓰기 시작할 때 주석을 풀고 이름을 확정한다.

# ── 공고 출처 API (worker/tools, 이후 backend 수집기) ──
# 공공데이터포털(data.go.kr) 일반 인증키(Decoding) — 노인 구인정보·1365 봉사참여정보 공용
DATA_GO_KR_SERVICE_KEY=
# 서울50플러스 API 인증키 (관리자 승인 후 발급)
SEOUL50PLUS_API_KEY=

# ── 백엔드 (#14 W02-03) ──
# development | test | production. 비우면 production으로 동작한다 (API 문서 화면 닫힘).
# 개발 PC에서만 주석을 풀어 development로 둔다. 운영 서버의 .env에는 넣지 않거나 production으로 둔다.
# APP_ENV=development
# 내부 Ollama (#29 W04-02). 기본값은 Compose 서비스 주소·qwen3:4b. 출처(scheme://host:port)만 적는다
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen3:4b

# 변경 API의 단일 공개 출처. 개발 Vite 프록시에서는 http://localhost:5173을 명시한다.
# PUBLIC_ORIGIN=https://your-site.example
# 전달 헤더를 신뢰할 직접 연결 프록시 IP만 JSON 배열로 지정한다. 기본은 [] (신뢰 안 함).
# TRUSTED_PROXY_IPS=[]
# 한도 식별용 32바이트 HMAC 키(hex 64자), 운영 Redis 제어 레코드와 일치하는 세대 UUID.
# REQUEST_LIMIT_KEY=
# INFERENCE_CONTROL_EPOCH=

# ── 개발 DB·Redis (#18 W02-07, 로컬 Compose 전용. 운영 RDS 접속 정보는 여기에 두지 않는다) ──
POSTGRES_DB=reconnect
POSTGRES_USER=reconnect
POSTGRES_PASSWORD=
# Redis 비밀번호는 32자 이상 hex로 생성한다. 서버 인자/로그 대신 stdin 설정으로 전달한다.
REDIS_PASSWORD=
# 개발 PC용: 아래 비밀번호 자리에 위와 같은 값을 넣는다. 비밀번호에 URL 예약 문자가 있으면 인코딩한다.
# DATABASE_URL=postgresql+psycopg://reconnect:<DB-password>@127.0.0.1:5432/reconnect
# REDIS_URL=redis://:<Redis-password>@127.0.0.1:6379/0
# 운영 DATABASE_URL은 sslmode=verify-full과 sslrootcert=/run/rds-ca.pem이 필수다.

# ── 카카오 로그인 (#7 W01-04) ──
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
