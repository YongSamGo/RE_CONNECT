# 편집기 공통 설정 — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# 줄 끝 공백 두 칸이 줄바꿈 표시라 지우지 않는다
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
