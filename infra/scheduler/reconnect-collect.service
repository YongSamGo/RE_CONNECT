# 활성 출처 전체를 `--due`로 차례로 수집한다(W12-07). 실제 실행 여부는 DB의 다음 실행 시각이 정한다:
# 성공 후 6시간, 실패 후 15분. 출처 일일 한도·같은 출처 잠금은 명령 안에서 지킨다.
[Unit]
Description=RE_CONNECT 공고 주기 수집 (--all-due)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/re-connect/scheduler.env
# 출처당 최대 600초 + 잠금·DB 여유. 넘으면 강제 종료되고 다음 타이머에서 저장된 페이지부터 재개한다.
TimeoutStartSec=1800
# systemd는 WorkingDirectory에 환경변수를 치환하지 않으므로 셸에서 이동한다. -f로 infra/ 파일을 쓰면
# Compose가 .env를 infra/에서 찾으므로 --env-file을 붙인다(infra/README.md).
ExecStart=/bin/sh -c 'cd "$RECONNECT_DIR" && exec /usr/bin/docker compose --env-file .env run --rm --no-deps -T "$BACKEND_SERVICE" python -m app.collect --all-due'
