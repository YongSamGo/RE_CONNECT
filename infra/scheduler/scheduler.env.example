# /etc/re-connect/scheduler.env 로 복사해 값을 채운다(root 소유, 0600). 비밀값은 넣지 않는다.
# 비밀값은 운영 Compose의 env_file이 컨테이너에 넘긴다(#93).
RECONNECT_DIR=/opt/re-connect
# docker compose가 읽는 표준 변수. 운영 Compose 파일과 프로젝트 이름(#93)에 맞춘다.
COMPOSE_FILE=infra/compose.prod.yaml
COMPOSE_PROJECT_NAME=re-connect
# 운영 Compose의 FastAPI 서비스 이름
BACKEND_SERVICE=backend
