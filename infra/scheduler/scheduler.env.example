# /etc/reconnect/scheduler.env 로 복사한다(root 소유, 0600). 비밀값은 넣지 않는다.
# 경로는 운영 배포 절차(infra/deploy/README.md 6절)와 같아야 한다.
# 릴리스 태그를 체크아웃한 저장소 경로
RECONNECT_DIR=/opt/reconnect
# docker compose 표준 변수. 프로젝트 이름은 Compose 파일의 name(reconnect-prod)을 쓴다.
COMPOSE_FILE=infra/compose.prod.yaml
# 배포 때 tmpfs에 만드는 이미지 digest·AWS_REGION·DEPLOY_ENV 파일. Compose 변수 치환에 쓴다.
IMAGES_ENV_FILE=/run/reconnect/images.env
# backend 서비스의 env_file. Compose도 같은 이름의 변수로 경로를 읽는다.
APP_ENV_FILE=/run/reconnect/app.env
# 운영 Compose의 FastAPI 서비스 이름
BACKEND_SERVICE=backend
