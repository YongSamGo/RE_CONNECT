    337.38043212890625,
    386.25811767578125,
    449.44140625,
    396.1581115722656
   ],
   "block": 34,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "아키텍처 설계서 검토",
   "bbox": [
    337.38043212890625,
    399.2784118652344,
    408.13031005859375,
    409.17840576171875
   ],
   "block": 34,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "1-2 중요자원이 식별되어 있는지 확인",
