   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "과 세션에 저장된 토큰값을 비교하여 유효성을 검사하도록 설계한다.",
   "bbox": [
    91.49980926513672,
    327.19061279296875,
