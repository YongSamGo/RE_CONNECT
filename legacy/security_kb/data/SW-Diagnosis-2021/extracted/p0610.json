   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "한다. MD5, SHA, SHA‐1, SHA‐256 등의 알고리즘이 있다.",
   "bbox": [
    91.26000213623047,
    580.7999877929688,
    325.4902038574219,
    591.8331298828125
   ],
   "block": 43,
   "size": 9.92959213256836,
   "fonts": [
    "KoPubDotumLight",
    "HaansoftBatang"
   ]
  },
  {
   "text": "화이트리스트(Whitelist)",
