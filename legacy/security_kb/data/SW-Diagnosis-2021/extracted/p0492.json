    388.97308349609375
   ],
   "block": 23,
   "size": 10.888216018676758,
   "fonts": [
    "KoPubDotumBold"
   ]
  },
  {
   "text": "보안결정에서 도메인명을 이용한 DNS lookup을 하지 않도록 한다.",
   "bbox": [
    76.5,
    397.8712158203125,
