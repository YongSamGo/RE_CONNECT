    189.03851318359375
   ],
   "block": 27,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "설계서, 클래스설계서 등에서 확인",
   "bbox": [
    95.28143310546875,
    192.21823120117188,
