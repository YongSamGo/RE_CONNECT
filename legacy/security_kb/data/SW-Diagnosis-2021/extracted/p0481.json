   "bbox": [
    70.86001586914062,
    434.1111145019531,
    281.2032165527344,
    445.13311767578125
   ],
   "block": 36,
   "size": 9.895223617553711,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "아래의 코드는 멤버 변수 colors는 private로 선언되었지만 public으로 선언된 getUserColors ",
   "bbox": [
    70.86001586914062,
    461.11102294921875,
    459.1924743652344,
    472.1330261230469
