   "bbox": [
    70.86000061035156,
    130.81100463867188,
    360.7610168457031,
    141.8330078125
   ],
   "block": 25,
   "size": 9.895223617553711,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
