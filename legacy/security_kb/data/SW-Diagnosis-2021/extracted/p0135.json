   ],
   "block": 23,
   "size": 7.582552433013916,
   "fonts": [
    "SDGogoRound03Rg",
    "HaansoftBatang"
   ]
  },
  {
   "text": "진단방법",
   "bbox": [
    186.17999267578125,
    117.5182113647461,
    216.187255859375,
    127.418212890625
   ],
   "block": 24,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "관련산출물 검토예시",
