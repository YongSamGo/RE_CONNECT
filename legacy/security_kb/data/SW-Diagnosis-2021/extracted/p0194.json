   "block": 23,
   "size": 9.895223617553711,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "동적 코드에 사용되는 사용자 입력 값을 필터링 한다.",
   "bbox": [
    76.5,
    353.35107421875,
    278.21356201171875,
