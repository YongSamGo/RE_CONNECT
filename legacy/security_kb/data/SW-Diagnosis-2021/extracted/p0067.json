    306.75811767578125,
    118.1102523803711,
    316.6581115722656
   ],
   "block": 30,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "MS Anti‐XSS Library: http://wpl.codeplex.com/",
   "bbox": [
    136.4398956298828,
    229.45018005371094,
    313.3865966796875,
    239.37820434570312
   ],
   "block": 31,
   "size": 8.939798355102539,
   "fonts": [
    "KoPubDotumLight",
    "HaansoftBatang"
   ]
  },
  {
   "text": "ASP .NET 웹기반 애플리케이션 개발시, XSS공격으로부터 안전할 수 있도록 도와주는 인코딩 ",
   "bbox": [
    136.439697265625,
    242.01791381835938,
    450.2248840332031,
    251.91790771484375
   ],
   "block": 31,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "라이브러리이다.",
   "bbox": [
    136.439697265625,
    254.49819946289062,
    190.02615356445312,
    264.398193359375
   ],
   "block": 31,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "MS AntiXSSEncoder 클래스: ",
   "bbox": [
    136.439697265625,
    269.1979064941406,
    241.47669982910156,
    279.097900390625
   ],
   "block": 32,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "http://social.msdn.microsoft.com/Search/en-US?query=antixssencoder&pgArea=",
   "bbox": [
    136.439697265625,
    281.6781921386719,
    447.6409912109375,
    291.57818603515625
   ],
   "block": 32,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "header&emptyWater- mark=true&ac=4",
   "bbox": [
    136.439697265625,
    294.2178955078125,
    284.7368469238281,
    304.1178894042969
   ],
   "block": 32,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "HTML, XML, CSS, URL 문자열을 인코딩하여 XSS공격의 위협에 대응할 수 있는 클래스이다. ",
   "bbox": [
    136.439697265625,
    306.7575988769531,
    450.2741394042969,
    316.6575927734375
   ],
   "block": 32,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "HttpEncoder클래스의 HttpUtility, HttpServerUtility, HttpResponseH-eader 메서드를 ",
   "bbox": [
    136.439697265625,
    319.2378845214844,
    450.27587890625,
    329.13787841796875
   ],
   "block": 32,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
