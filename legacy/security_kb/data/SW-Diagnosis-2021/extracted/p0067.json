    214.83822631835938,
    115.7472915649414,
    224.73822021484375
   ],
   "block": 29,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "활용 가능한 프레임워크 또는 라이브러리",
