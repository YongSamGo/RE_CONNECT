    241.29818725585938
   ],
   "block": 35,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "세션을 완전히 제거한다.",
   "bbox": [
    97.32030487060547,
