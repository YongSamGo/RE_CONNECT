   "bbox": [
    337.38043212890625,
    568.89892578125,
    449.44140625,
    578.7989501953125
   ],
   "block": 42,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
