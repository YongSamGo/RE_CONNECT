    327.89276123046875
   ],
   "block": 32,
   "size": 9.895223617553711,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "페이지가 이동(리다이렉트 또는 포워드)할 URL을 사전에 정의하고 있는지 확인한다.",
   "bbox": [
