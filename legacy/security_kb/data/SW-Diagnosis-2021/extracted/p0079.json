    239.89111328125,
    394.9131774902344,
    250.91311645507812
   ],
   "block": 29,
   "size": 9.895223617553711,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "요구사항 ②",
   "bbox": [
    70.86000061035156,
    277.87091064453125,
    116.55386352539062,
    288.8929138183594
