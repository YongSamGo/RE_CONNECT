   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "진단방법",
   "bbox": [
    186.17999267578125,
    135.09823608398438,
    216.187255859375,
    144.99822998046875
   ],
   "block": 25,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "관련산출물 검토예시",
