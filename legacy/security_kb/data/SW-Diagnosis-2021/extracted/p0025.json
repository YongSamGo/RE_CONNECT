    172.2982177734375
   ],
   "block": 28,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight",
    "HaansoftBatang"
   ]
  },
  {
   "text": "내용을 합의하고 정리하여 체계적으로 작성한 문서를 말하며 요구사항 정의서에는 요구사항 ",
   "bbox": [
