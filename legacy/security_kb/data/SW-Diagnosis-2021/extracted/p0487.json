   "block": 26,
   "size": 9.895223617553711,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "하여 배열수정과 객체 속성변경이 가능해진다.",
   "bbox": [
    70.86000061035156,
    197.65109252929688,
