    195.57846069335938,
    328.24517822265625,
    205.47845458984375
   ],
   "block": 28,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "설계서에 설계항목 적용계획이 수립되어 있고, 요구사항추적표로 요구",
   "bbox": [
    95.28057861328125,
    208.59878540039062,
    325.69580078125,
    218.498779296875
   ],
   "block": 28,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "사항 추적 가능 여부 확인",
   "bbox": [
