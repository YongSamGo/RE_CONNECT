    459.17877197265625,
    150.8331298828125
   ],
   "block": 25,
   "size": 9.895223617553711,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "않도록 보안설계가 적용되어 있는가?",
   "bbox": [
    84.18021392822266,
    156.79104614257812,
