    187.9581298828125
   ],
   "block": 27,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "관련산출물 검토예시",
   "bbox": [
    357.7200012207031,
