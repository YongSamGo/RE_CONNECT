    221.61911010742188,
    178.09152221679688,
    231.51910400390625
   ],
   "block": 28,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "요구사항정의서, 요구사항추적표, ",
   "bbox": [
    337.38043212890625,
