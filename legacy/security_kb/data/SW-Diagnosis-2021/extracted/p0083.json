    511.0309753417969,
    446.9382629394531,
    522.052978515625
   ],
   "block": 40,
   "size": 9.895223617553711,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "취약한 API를 정의하고 있는지 확인한다.",
   "bbox": [
