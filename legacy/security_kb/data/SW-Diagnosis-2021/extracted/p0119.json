   "text": "변경해야 하며, 이전의 비밀번호와 연관성이 없어야 한다.",
   "bbox": [
    85.86000061035156,
    471.4306945800781,
    304.8641662597656,
    482.45269775390625
   ],
   "block": 44,
   "size": 9.895223617553711,
   "fonts": [
