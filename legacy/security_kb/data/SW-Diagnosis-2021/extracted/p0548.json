    337.2771911621094,
    237.63818359375
   ],
   "block": 24,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "구현방안",
   "bbox": [
    253.9199981689453,
    244.05810546875,
    283.92730712890625,
    253.95809936523438
   ],
   "block": 25,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "①업로드 가능한 파일의 타입으로 확장자가 gif, jpg, jpeg, png인 이미지 파일로 제한한다.",
   "bbox": [
    91.92034912109375,
    260.4381103515625,
    394.998291015625,
    270.3381042480469
   ],
   "block": 26,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "②업로드 가능한 파일의 크기는 2kb로 제한하고, 한번에 3개의 파일만 업로드할 수 있도록 제한한다.",
   "bbox": [
    91.92034912109375,
    271.6584167480469,
    425.47998046875,
    281.55841064453125
   ],
   "block": 26,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "③업로드한 파일은 스토리지에 날짜별로, 실행 권한을 제거하고 저장한다.",
   "bbox": [
    91.92034912109375,
    282.9381103515625,
    336.9161071777344,
    292.8381042480469
   ],
   "block": 26,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
