    263.8581237792969,
    328.24517822265625,
    273.75811767578125
   ],
   "block": 29,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "설계서에 설계항목 적용계획이 수립되어 있고, 요구사항추적표로 요구",
   "bbox": [
    95.28057861328125,
    276.87841796875,
    325.69580078125,
    286.7784118652344
   ],
   "block": 29,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
