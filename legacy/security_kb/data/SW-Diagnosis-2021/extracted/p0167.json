    289.9581298828125,
    178.09152221679688,
    299.8581237792969
   ],
   "block": 29,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "요구사항정의서, 요구사항추적표, ",
   "bbox": [
    337.38043212890625,
    270.3984375,
    449.44140625,
    280.2984313964844
   ],
   "block": 30,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "아키텍처 설계서 검토",
   "bbox": [
