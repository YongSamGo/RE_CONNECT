    73.86000061035156,
    549.3980712890625,
    154.08807373046875,
    559.298095703125
   ],
   "block": 35,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "2.5.4. 암호키 사용 유효기간",
