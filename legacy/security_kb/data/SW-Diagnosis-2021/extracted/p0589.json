    278.28729248046875,
    361.2981872558594
   ],
   "block": 41,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "①공통모듈로 대칭 암/복호화 기능과 비대칭 암/복호화 기능을 추가한다.",
   "bbox": [
    86.28034973144531,
    368.9184875488281,
    328.93560791015625,
    378.8184814453125
   ],
   "block": 42,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "②대칭 암/복호화 기능은 AES 알고리즘을 이용하며, 키 길이는 256으로 설정한다.",
   "bbox": [
    86.28034973144531,
    381.7587890625,
    362.2962951660156,
    391.6587829589844
   ],
   "block": 42,
   "size": 8.907171249389648,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "③비대칭 암/복호화 기능은 RSA 알고리즘을 이용하며, 키 길이는 2048로 설정한다.",
   "bbox": [
    86.28034973144531,
    394.6584777832031,
    367.5166931152344,
    404.5584716796875
   ],
   "block": 42,
