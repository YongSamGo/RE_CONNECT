   "size": 10.398963928222656,
   "fonts": [
    "NanumSquareRoundB"
   ]
  },
  {
   "text": "진단원은 보안설계 기준을 기반으로 분석·설계 산출물의 작성 현황과 세부 내용을 검토하여 ",
   "bbox": [
    91.5,
    583.9310913085938,
    464.7662048339844,
    594.953125
