  {
   "text": "def load_user_object(request):",
   "bbox": [
    104.41199493408203,
    195.35389709472656,
    221.9427490234375,
    204.36480712890625
   ],
   "block": 33,
   "size": 8.510202407836914,
   "fonts": [
    "Haansoft Batang",
    "KoPubDotumLight"
   ]
  },
  {
   "text": "  # 데이터 변조를 확인하기 위한 해시값",
   "bbox": [
    104.41199493408203,
    211.0762939453125,
    249.9309539794922,
    219.58551025390625
   ],
   "block": 34,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "  hashed_pickle = request.POST.get(\"hashed_pickle\", \"\")",
   "bbox": [
    104.41199493408203,
    226.4168243408203,
    324.6253662109375,
    234.92604064941406
   ],
   "block": 35,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "  # 사용자로부터 입력받은 데이터를 직렬화(pickle)",
   "bbox": [
    104.41199493408203,
    256.9780578613281,
    287.7051086425781,
    265.4872741699219
   ],
   "block": 36,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "  pickled_userinfo = pickle.dumps(request.POST.get(\"userinfo\", \"\"))",
   "bbox": [
    104.41199493408203,
    272.1987609863281,
    365.7431640625,
    280.7079772949219
   ],
   "block": 37,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "  # HMAC 검증을 위한 비밀키는 생성",
   "bbox": [
    104.41199493408203,
    302.760009765625,
    245.13552856445312,
    311.26922607421875
   ],
   "block": 38,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "  m = hmac.new(key=\"secret_key\".encode(\"utf-8\"), digestmod=hashlib.sha512)",
   "bbox": [
    104.41199493408203,
    318.1005554199219,
    414.1728820800781,
    326.6097717285156
   ],
   "block": 39,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "  # 직렬화된 사용자 입력값을 해싱",
   "bbox": [
    104.41199493408203,
    348.66180419921875,
    230.99017333984375,
    357.1710205078125
   ],
   "block": 40,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "  m.update(pickled_userinfo)",
   "bbox": [
    104.41199493408203,
    363.8824768066406,
    216.2584686279297,
    372.3916931152344
   ],
   "block": 41,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "  # 전달받은 해시값(hashed_pickle)과 직렬화 데이터(userinfo)의 해시값을 비교하여 검증",
   "bbox": [
    104.41199493408203,
    394.4437255859375,
    427.4676513671875,
    402.95294189453125
   ],
   "block": 42,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "  if hmac.compare_digest(str(m.digest()), hashed_pickle):",
   "bbox": [
    104.41199493408203,
    409.7842712402344,
    328.5132751464844,
    418.2934875488281
   ],
   "block": 43,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    user_obj = pickle.loads(pickled_userinfo)",
   "bbox": [
    104.41199493408203,
    425.0049743652344,
    278.476318359375,
    433.5141906738281
   ],
   "block": 44,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    return render(request, \"/load_user_obj.html\", {\"obj\": user_obj})",
   "bbox": [
    104.41199493408203,
    440.34552001953125,
    363.2264099121094,
    448.854736328125
   ],
   "block": 45,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "  else:",
   "bbox": [
