    "KoPubDotumLight"
   ]
  },
  {
   "text": "35:",
   "bbox": [
    82.23493194580078,
    638.9336547851562,
    94.51488494873047,
    647.44287109375
   ],
   "block": 39,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "import os",
   "bbox": [
    104.41199493408203,
    119.392578125,
    142.28396606445312,
    127.90178680419922
   ],
   "block": 40,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "import socket",
   "bbox": [
    104.41199493408203,
    134.7331085205078,
    158.38035583496094,
    143.24232482910156
   ],
   "block": 41,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "import ssl",
   "bbox": [
    104.41199493408203,
    149.9538116455078,
    143.90707397460938,
    158.46302795410156
   ],
   "block": 42,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "CURRENT_PATH = os.getcwd()",
   "bbox": [
    104.41199493408203,
    180.51504516601562,
    227.40570068359375,
    189.02426147460938
   ],
   "block": 43,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "HOST_NAME = \"test-server\"",
   "bbox": [
    104.41199493408203,
    195.8555908203125,
    217.4203643798828,
    204.36480712890625
   ],
   "block": 44,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "HOST, PORT = \"127.0.0.1\", 7917",
   "bbox": [
    104.41199493408203,
    211.0762939453125,
    236.3926239013672,
    219.58551025390625
   ],
   "block": 45,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "SERVER_CA_PEM = f\"{CURRENT_PATH}/rsa_server/CA.pem\"  # 서버로부터 전달받은 CA 인증서",
   "bbox": [
    104.41199493408203,
    226.4168243408203,
    473.4989929199219,
    234.92604064941406
   ],
   "block": 46,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "def connect_with_server():",
   "bbox": [
    104.41199493408203,
    256.9780578613281,
    207.9179229736328,
    265.4872741699219
   ],
   "block": 47,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    with socket.socket(socket.AF_INET, socket.SOCK_STREAM, 0) as sock:",
   "bbox": [
    104.41199493408203,
    287.539306640625,
    403.6736145019531,
    296.04852294921875
   ],
   "block": 48,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        # PROTOCOL_TLS_CLIENT 프로토콜을 추가하여 인증서 유효성 검사와 호스트 이름 확인을 위한",
   "bbox": [
    104.41199493408203,
    302.760009765625,
    484.8882751464844,
    311.26922607421875
   ],
   "block": 49,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        # context를 구성. verify_mode가 CERT_REQUIRED로 설정됨",
   "bbox": [
    104.41199493408203,
    318.1005554199219,
    369.3274841308594,
    326.6097717285156
   ],
   "block": 50,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        # check_hostname이 True로 설정됨",
   "bbox": [
    104.41199493408203,
    333.3212585449219,
    274.50482177734375,
    341.8304748535156
   ],
   "block": 51,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)",
   "bbox": [
    104.41199493408203,
    348.66180419921875,
    352.9177551269531,
    357.1710205078125
   ],
   "block": 52,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        # 서버로부터 전달받은 CA 인증서를 context에 로드",
   "bbox": [
    104.41199493408203,
    379.2230224609375,
    326.6519470214844,
    387.73223876953125
   ],
   "block": 53,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        # CERT_REQUIRED로 인해 필수",
   "bbox": [
    104.41199493408203,
    394.4437255859375,
    260.83929443359375,
    402.95294189453125
   ],
   "block": 54,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        context.load_verify_locations(SERVER_CA_PEM)",
   "bbox": [
    104.41199493408203,
    409.7842712402344,
    322.3446960449219,
    418.2934875488281
   ],
   "block": 55,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        # 호스트 이름(HOST_NAME)이 일치하지 않으면 통신 불가",
   "bbox": [
    104.41199493408203,
    440.34552001953125,
    350.38665771484375,
    448.854736328125
   ],
   "block": 56,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        # 생성된 소켓과 context wrapping 시 server_hostname이 실제 서버에서",
   "bbox": [
    104.41199493408203,
    455.5661926269531,
    409.9651184082031,
    464.0754089355469
   ],
   "block": 57,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        # 등록(server.csr)한 호스트 명과 일치해야 함",
   "bbox": [
    104.41199493408203,
    470.90673828125,
    303.6353454589844,
    479.41595458984375
   ],
   "block": 58,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        with context.wrap_socket(sock, server_hostname=HOST_NAME) as ssock:",
   "bbox": [
    104.41199493408203,
    486.12744140625,
    430.28643798828125,
    494.63665771484375
   ],
   "block": 59,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "            try:",
   "bbox": [
    104.41199493408203,
    501.4679870605469,
    167.9977264404297,
    509.9772033691406
   ],
   "block": 60,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "                ssock.connect((HOST, PORT))",
   "bbox": [
    104.41199493408203,
    516.6886596679688,
    288.42352294921875,
    525.1978759765625
   ],
   "block": 61,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "                ssock.send(\"Hello I'm a patched client :)\".encode(\"utf-8\"))",
   "bbox": [
    104.41199493408203,
    547.2499389648438,
    399.6683044433594,
    555.7591552734375
   ],
   "block": 62,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "                data = ssock.recv(1024).decode(\"utf-8\")",
   "bbox": [
    104.41199493408203,
    577.8111572265625,
    327.864990234375,
    586.3203735351562
   ],
   "block": 63,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "                print(f\">> server from ({HOST}, {PORT}): {data}\\n\")",
   "bbox": [
    104.41199493408203,
    608.3723754882812,
    368.3795471191406,
    616.881591796875
   ],
   "block": 64,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "            finally:",
   "bbox": [
    104.41199493408203,
    623.7129516601562,
    179.98574829101562,
    632.22216796875
   ],
   "block": 65,
   "size": 8.510202407836914,
