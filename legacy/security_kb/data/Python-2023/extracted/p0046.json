    506.9654846191406,
    120.87869262695312
   ],
   "block": 3,
   "size": 9.948545455932617,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "되어 있는지도 확인해야 한다.",
