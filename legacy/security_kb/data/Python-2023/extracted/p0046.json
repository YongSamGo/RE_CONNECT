    191.70884704589844
   ],
   "block": 6,
   "size": 9.948545455932617,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "xxe.xml 데이터를 전송하고 이를 파싱할 때 /etc/passwd 파일을 참조할 수 있다.",
