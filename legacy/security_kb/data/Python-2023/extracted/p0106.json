  },
  {
   "text": "# 전자서명 검증에 사용한 코드는 의존한 파이썬 패키지 및 송신측 언어에 따라 ",
   "bbox": [
    104.41199493408203,
    119.392578125,
    387.62994384765625,
    127.90178680419922
   ],
   "block": 44,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "# 달라질 수 있으며, 사전에 공유한 공개키로 복호화한 전자서명과 원본 데이터 해시값의",
   "bbox": [
    104.41199493408203,
    133.41477966308594,
    417.2775573730469,
    141.9239959716797
   ],
   "block": 45,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "# 일치 여부를 검사하는 코드를 포함",
   "bbox": [
    104.41199493408203,
    147.43699645996094,
    234.10694885253906,
    155.9462127685547
   ],
   "block": 46,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "def verify_digit_signature (",
   "bbox": [
    104.41199493408203,
    161.45921325683594,
    208.8251953125,
    169.9684295654297
   ],
   "block": 47,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "  origin_data: bytes, origin_signature: bytes, client_pub_key: str ) -> bool:",
   "bbox": [
    104.41199493408203,
    175.48143005371094,
    399.5994873046875,
    183.9906463623047
   ],
   "block": 48,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    hashed_data = SHA256.new(origin_data)",
   "bbox": [
    104.41199493408203,
    189.50364685058594,
    279.0743713378906,
    198.0128631591797
   ],
   "block": 49,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    signer = SIGNATURE_PKCS1_v1_5.new(RSA.importKey(client_pub_key))",
   "bbox": [
    104.41199493408203,
    203.40602111816406,
    400.50848388671875,
    211.9152374267578
   ],
   "block": 50,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    return signer.verify(hashed_data, base64.b64decode(origin_signature))",
   "bbox": [
    104.41199493408203,
    231.450439453125,
    393.31549072265625,
    239.95965576171875
   ],
   "block": 51,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "def verify_data(request):",
   "bbox": [
    104.41199493408203,
    259.494873046875,
    199.40589904785156,
    268.00408935546875
   ],
   "block": 52,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    # 클라이언트로부터 전달받은 데이터",
   "bbox": [
    104.41199493408203,
    273.51708984375,
    249.9309539794922,
    282.02630615234375
   ],
   "block": 53,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    encrypted_code = request.POST.get(\"encrypted_msg\", \"\")  # 암호화된 파이썬 코드",
   "bbox": [
    104.41199493408203,
    287.4194641113281,
    437.8961486816406,
    295.9286804199219
   ],
   "block": 54,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    encrypted_sig = request.POST.get(\"encrypted_sig\", \"\")  # 암호화된 전자서명",
   "bbox": [
    104.41199493408203,
    301.4416809082031,
    413.2017822265625,
    309.9508972167969
   ],
   "block": 55,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "   ",
   "bbox": [
    104.41199493408203,
    315.4638977050781,
    115.39144134521484,
    323.9731140136719
   ],
   "block": 56,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    # 서버의 대칭(비밀)키 및 공개키 로드",
   "bbox": [
    104.41199493408203,
    329.4861145019531,
    256.28472900390625,
    337.9953308105469
   ],
   "block": 57,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    with open(f\"/keys/secret_key.out\", \"rb\") as f:",
   "bbox": [
    104.41199493408203,
    343.5083312988281,
    298.18365478515625,
    352.0175476074219
   ],
   "block": 58,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        secret_key = f.read()",
   "bbox": [
    104.41199493408203,
    357.5305480957031,
    220.45323181152344,
    366.0397644042969
   ],
   "block": 59,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    with open(f\"/keys/public_key.out\", \"rb\") as f:",
   "bbox": [
    104.41199493408203,
    385.45513916015625,
    296.8650207519531,
    393.96435546875
   ],
   "block": 60,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        public_key = f.read()",
   "bbox": [
    104.41199493408203,
    399.4773254394531,
    219.01544189453125,
    407.9865417480469
   ],
   "block": 61,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    # 대칭키로 파이썬 코드 및 전자서명 복호화",
   "bbox": [
    104.41199493408203,
    427.5217590332031,
    277.5017395019531,
    436.0309753417969
   ],
   "block": 62,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    origin_python_code = decrypt_with_symmetric_key(symmetric_key, encrypted_code)",
   "bbox": [
    104.41199493408203,
    441.5439758300781,
    450.2550354003906,
    450.0531921386719
   ],
   "block": 63,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    origin_signature = decrypt_with_symmetric_key(symmetric_key, encrypted_sig)",
   "bbox": [
    104.41199493408203,
    455.44635009765625,
    429.51763916015625,
    463.95556640625
   ],
   "block": 64,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
