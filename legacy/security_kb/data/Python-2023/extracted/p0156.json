    346.8401184082031
   ],
   "block": 9,
   "size": 8.797677993774414,
   "fonts": [
    "GmarketSansTTFMedium"
   ]
  },
  {
   "text": "표시 방법",
   "bbox": [
    306.1632995605469,
    337.85150146484375,
    343.2174072265625,
    346.8401184082031
   ],
   "block": 9,
   "size": 8.797677993774414,
   "fonts": [
    "GmarketSansTTFMedium"
   ]
  },
  {
   "text": "public",
   "bbox": [
    94.58216094970703,
    355.373291015625,
    117.11043548583984,
    363.88250732421875
   ],
   "block": 10,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "attribute, method는 기본적으로 public",
   "bbox": [
    149.48536682128906,
    355.373291015625,
    292.96942138671875,
    363.88250732421875
   ],
   "block": 10,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "protect",
   "bbox": [
    92.30451965332031,
    378.7436218261719,
    119.30204010009766,
    387.2528381347656
   ],
   "block": 11,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "attribute, method 앞에 _(single underscore)를 붙여서 표시 함.",
   "bbox": [
    149.48536682128906,
    372.2718505859375,
    386.75592041015625,
    380.78106689453125
   ],
   "block": 11,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "실제 제약 보다는 관례적임.",
   "bbox": [
    149.48536682128906,
    385.0955810546875,
    246.14138793945312,
    393.60479736328125
   ],
   "block": 12,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "private",
   "bbox": [
    92.90390014648438,
    414.6980285644531,
    118.66473388671875,
    423.2072448730469
   ],
   "block": 13,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "attribute, method 앞에 __(double underscore)를 붙여서 표시 함.",
   "bbox": [
    149.48536682128906,
    401.994140625,
    394.068359375,
    410.50335693359375
   ],
   "block": 14,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "파이썬은 네임 맹글링(name mangling)으로 private 멤버에 _class__member로 접근은 가능하지만 ",
   "bbox": [
    149.48536682128906,
    414.6980285644531,
    502.2311096191406,
    423.2072448730469
   ],
   "block": 14,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "바람직하지 않음.",
   "bbox": [
    149.48536682128906,
    427.5217590332031,
    208.02081298828125,
    436.0309753417969
   ],
   "block": 15,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "나. 안전한 코딩기법",
   "bbox": [
    65.09266662597656,
    460.5279235839844,
    151.7301788330078,
    471.07452392578125
   ],
   "block": 16,
   "size": 10.547856330871582,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "private로 선언된 배열을 public으로 선언된 메소드로 반환하지 않도록 한다. private 배열에 대한 복사본을 ",
   "bbox": [
    75.04237365722656,
    482.4600830078125,
    507.3238525390625,
    492.407470703125
   ],
   "block": 17,
   "size": 9.948545455932617,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "반환하도록 하고 배열의 원소에 대해서는 clone() 메소드를 통해 복사된 원소를 저장하도록 해서 private 선언된 ",
   "bbox": [
    65.09266662597656,
    500.4372863769531,
    507.3236083984375,
    510.3846740722656
   ],
   "block": 18,
   "size": 9.948545455932617,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "배열과 객체 속성에 대한 의도치 않은 수정을 방지한다. 만약 배열의 원소가 String 타입 등과 같이 변경이 ",
   "bbox": [
    65.09266662597656,
    518.41455078125,
    506.96392822265625,
    528.3619384765625
   ],
   "block": 19,
   "size": 9.948545455932617,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "되지 않는 경우(immutable)에는 private 배열의 복사본을 만들고 이를 반환하도록 작성한다.",
   "bbox": [
    65.09266662597656,
    536.3917236328125,
    450.2422790527344,
    546.339111328125
   ],
   "block": 20,
   "size": 9.948545455932617,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "다. 코드예제",
   "bbox": [
    65.09266662597656,
    568.271240234375,
    119.12395477294922,
    578.81787109375
   ],
   "block": 21,
   "size": 10.547856330871582,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "다음 예제는 private 변수를 생성하고 이를 반환하는 public 메소드를 사용하는 예시를 보여 준다. 이 경우 ",
   "bbox": [
    75.04237365722656,
    590.2034912109375,
    507.0839538574219,
    600.15087890625
   ],
   "block": 22,
   "size": 9.948545455932617,
   "fonts": [
    "KoPubDotumMedium"
   ]
  },
  {
   "text": "외부에서 클래스 내에 숨겨져 있는 private 배열 값에 접근할 수 있는 문제점이 발생한다.",
   "bbox": [
    65.09266662597656,
    608.1806640625,
    437.295654296875,
    618.1280517578125
   ],
   "block": 23,
   "size": 9.948545455932617,
   "fonts": [
    "KoPubDotumMedium"
   ]
  }
