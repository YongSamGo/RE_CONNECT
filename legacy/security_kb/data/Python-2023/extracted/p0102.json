   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "from django.core.exceptions import ValidationError",
   "bbox": [
    104.41199493408203,
    322.89447021484375,
    302.9515686035156,
    331.4036865234375
   ],
   "block": 16,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "from django.utils.translation import ugettext as _",
   "bbox": [
    104.41199493408203,
    335.11895751953125,
    298.4660339355469,
    343.628173828125
   ],
   "block": 16,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "class CustomValidator(object):",
   "bbox": [
    104.41199493408203,
    359.3282470703125,
    221.5830535888672,
    367.83746337890625
   ],
   "block": 17,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "  def validate(self, password, user=None):",
   "bbox": [
    104.41199493408203,
    371.43292236328125,
    272.6499938964844,
    379.942138671875
   ],
   "block": 17,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    # 3종 이상 문자로 구성된 8자리 이상 패스워드 검사 정규식",
   "bbox": [
    104.41199493408203,
    383.5375671386719,
    336.601318359375,
    392.0467834472656
   ],
   "block": 17,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    PT1 = re.compile('^(?=.*[A-Z])(?=.*[a-z])[A-Za-z\\d!@#$%^&*]{8,}$')",
   "bbox": [
    104.41199493408203,
    395.6422119140625,
    382.049560546875,
    404.15142822265625
   ],
   "block": 17,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    PT2 = re.compile('^(?=.*[A-Z])(?=.*\\d)[A-Za-z\\d$@$!%*?&]{8,}$')",
   "bbox": [
    104.41199493408203,
    407.86669921875,
    372.8200378417969,
    416.37591552734375
   ],
   "block": 17,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    PT3 = re.compile('^(?=.*[A-Z])(?=.*[!@#$%^&*])[A-Za-z\\d!@#$%^&*]{8,}$')",
   "bbox": [
    104.41199493408203,
    419.9713439941406,
    390.318359375,
    428.4805603027344
   ],
   "block": 17,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    PT4 = re.compile('^(?=.*[a-z])(?=.*\\d)[A-Za-z\\d!@#$%^&*]{8,}$')",
   "bbox": [
    104.41199493408203,
    432.07598876953125,
    370.1815490722656,
    440.585205078125
   ],
   "block": 17,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    PT5 = re.compile('^(?=.*[a-z])(?=.*[!@#$%^&*])[A-Za-z\\d!@#$%^&*]{8,}$')",
   "bbox": [
    104.41199493408203,
    444.1806335449219,
    388.7611083984375,
    452.6898498535156
   ],
   "block": 17,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    PT6 = re.compile('^(?=.*\\d)(?=.*[!@#$%^&*])[A-Za-z\\d!@#$%^&*]{8,}$')",
   "bbox": [
    104.41199493408203,
    456.2852783203125,
    384.446044921875,
    464.79449462890625
   ],
   "block": 17,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    # 문자 구성 상관없이 10자리 이상 패스워드 검사 정규식",
   "bbox": [
    104.41199493408203,
    480.61444091796875,
