   "bbox": [
    104.41199493408203,
    516.9284057617188,
    236.92572021484375,
    525.4376220703125
   ],
   "block": 18,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        return None",
   "bbox": [
    104.41199493408203,
    529.0330200195312,
    185.6761474609375,
    537.542236328125
   ],
   "block": 18,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "      raise ValidationError(",
   "bbox": [
    104.41199493408203,
    541.1376953125,
    210.0225067138672,
