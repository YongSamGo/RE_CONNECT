    489.1236572265625
   ],
   "block": 18,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    PT7 = re.compile('^[A-Za-z\\d!@#$%^&*]{10,}$')",
   "bbox": [
    104.41199493408203,
    492.7190856933594,
    306.6453857421875,
    501.2283020019531
   ],
   "block": 18,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    for pattern in [PT1, PT2, PT3, PT4, PT5, PT6, PT7]:",
   "bbox": [
    104.41199493408203,
    504.82373046875,
    329.47174072265625,
    513.3329467773438
   ],
   "block": 18,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
