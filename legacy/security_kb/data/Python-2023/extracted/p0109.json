   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "HOST, PORT = \"127.0.0.1\", 7917",
   "bbox": [
    104.41199493408203,
    180.51504516601562,
    236.3926239013672,
    189.02426147460938
   ],
   "block": 32,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "def connect_with_server():",
   "bbox": [
    104.41199493408203,
    211.0762939453125,
    207.9179229736328,
    219.58551025390625
   ],
   "block": 33,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "    with socket.socket(socket.AF_INET, socket.SOCK_STREAM, 0) as sock:",
   "bbox": [
    104.41199493408203,
    241.6375274658203,
    403.6736145019531,
    250.14674377441406
   ],
   "block": 34,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        # 보안 정책 수동 설정",
   "bbox": [
    104.41199493408203,
    256.9780578613281,
    219.3629150390625,
    265.4872741699219
   ],
   "block": 35,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        context = ssl.SSLContext()",
   "bbox": [
    104.41199493408203,
    272.1987609863281,
    243.22886657714844,
    280.7079772949219
   ],
   "block": 36,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        # SSLContext 생성자를 직접 호출할 때, CERT_NONE이 기본값",
   "bbox": [
    104.41199493408203,
    302.760009765625,
    372.6839904785156,
    311.26922607421875
   ],
   "block": 37,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        # 상대방을 인증하지 않기 때문에 통신하고자하는 서버의 신뢰성을 보장할 수 없음",
   "bbox": [
    104.41199493408203,
    318.1005554199219,
    429.62469482421875,
    326.6097717285156
   ],
   "block": 38,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        context.verify_mode = ssl.CERT_NONE ",
   "bbox": [
    104.41199493408203,
    333.3212585449219,
    294.2464294433594,
    341.8304748535156
   ],
   "block": 39,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "        with context.wrap_socket(sock) as ssock:",
   "bbox": [
    104.41199493408203,
    363.8824768066406,
    302.13909912109375,
    372.3916931152344
   ],
   "block": 40,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "            try:",
   "bbox": [
    104.41199493408203,
    379.2230224609375,
    167.9977264404297,
    387.73223876953125
   ],
   "block": 41,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "                ssock.connect((HOST, PORT))",
   "bbox": [
    104.41199493408203,
    394.4437255859375,
    288.42352294921875,
    402.95294189453125
   ],
   "block": 42,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "                ssock.send(\"Hello I'm a vulnerable client :)\".encode(\"utf-8\"))",
   "bbox": [
    104.41199493408203,
    409.7842712402344,
    408.29937744140625,
    418.2934875488281
   ],
   "block": 43,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "                data = ssock.recv(1024).decode(\"utf-8\")",
   "bbox": [
    104.41199493408203,
    425.0049743652344,
    327.864990234375,
    433.5141906738281
   ],
   "block": 44,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "                print(f\">> server from ({HOST}, {PORT}): {data}\\n\")",
   "bbox": [
    104.41199493408203,
    440.34552001953125,
    368.37957763671875,
    448.854736328125
   ],
   "block": 45,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "            finally:",
   "bbox": [
    104.41199493408203,
    455.5661926269531,
    179.98660278320312,
    464.0754089355469
   ],
   "block": 46,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "                ssock.close()",
   "bbox": [
    104.41199493408203,
    470.90673828125,
    221.65159606933594,
    479.41595458984375
   ],
   "block": 47,
   "size": 8.510202407836914,
   "fonts": [
    "KoPubDotumLight"
   ]
  },
  {
   "text": "SSL 연결 시 PROTOCOL_TLS_CLIENT 프로토콜을 추가해 인증서 유효성 검사와 호스트 이름 확인을 ",
   "bbox": [
    75.04237365722656,
    524.6466064453125,
    506.96392822265625,
    534.593994140625
   ],
   "block": 49,
