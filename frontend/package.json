{
  "name": "reconnect-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run api:check && tsc -b && vite build",
    "api:generate": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:backend-contract": "vitest run --config vitest.contract.config.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "js-yaml": "4.3.2",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
